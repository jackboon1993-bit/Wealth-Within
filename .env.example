# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# If you leave these unset, the app still runs — it just skips accounts
# entirely and saves data to this browser's localStorage instead. That's
# fine for trying it out locally, but you need these set (and deployed
# as environment variables on your host) for other people to sign in and
# have their own saved data.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
