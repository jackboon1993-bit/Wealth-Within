# Copy this file to android/keystore.properties (same folder) and fill
# in your real values — keystore.properties itself is gitignored and
# must NEVER be committed, since this repo is public.
#
# storeFile is relative to the android/ folder (this file's location).
# If wealth-within-release.keystore lives outside the repo (e.g. in
# OneDrive, as generated in Session 3), use a full path instead, e.g.:
#   storeFile=C:\\Users\\jackb\\OneDrive\\Desktop\\Important WW\\wealth-within-release.keystore
# (double backslashes, since this is a Java .properties file)

storeFile=../wealth-within-release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
